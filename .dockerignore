# Node modules (re-installed inside container)
frontend/node_modules
frontend/.vite

# React build output (built inside container)
frontend/dist

# Python cache
backend/__pycache__
backend/**/__pycache__
**/*.pyc
**/*.pyo

# Python virtual envs
backend/venv
backend/.venv

# Model weights — uploaded to HF Model Hub separately
backend/models/*.pth

# Uploaded user images — ephemeral, not needed in image
backend/static/uploads/*

# Secrets — never bake into the image
backend/.env
frontend/.env

# Git internals
.git
.gitignore

# OS clutter
.DS_Store
Thumbs.db
